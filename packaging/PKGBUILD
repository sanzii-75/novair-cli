# novair — Arch Linux PKGBUILD
# Submit to AUR with:  git clone https://aur.archlinux.org/novair-cli.git && cp PKGBUILD novair-cli/
# Before submitting: set a real sha256sum for the tag archive (makepkg -g).
# Note: replace <YOUR_USERNAME> with the actual GitHub account hosting the repo.

_reponame="novair-cli"   # GitHub repo name (tarball extracts as ${_reponame}-${pkgver})
pkgname=novair-cli
pkgver=0.3.0
pkgrel=1
pkgdesc="⚡ Slick terminal AI agent for any OpenAI-compatible provider (OpenRouter, Ollama, Groq…)"
arch=("any")
url="https://github.com/sanzii-75/novair-cli"
license=("MIT")
depends=("python" "python-rich" "python-httpx")
makedepends=("python-build" "python-installer" "python-wheel")
optdepends=("ollama: run models locally without an API key")
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=("SKIP")  # TODO: replace with `makepkg -g` output after tagging v0.3.0

build() {
    cd "${_reponame}-$pkgver"
    python -m build --wheel --no-isolation
}

check() {
    cd "${_reponame}-$pkgver"
    python -m pytest --no-header -q tests
}

package() {
    cd "${_reponame}-$pkgver"
    python -m installer --destdir="$pkgdir" dist/*.whl
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
